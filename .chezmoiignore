# GitHub Actions (repository only, not synced to HOME)
.github/

# OAuth tokens, caches, credentials (should NOT be synced)
.claude.json

# Claude Code runtime files (should NOT be synced)
# Everything under .claude/ is excluded, then the authored config is opened back up
# one entry at a time. Runtime state (projects/, sessions/, caches, plans/) has no
# negation and therefore stays local.
.claude/*
!.claude/settings.json
!.claude/scripts/
!.claude/commands/
!.claude/CLAUDE.md
!.claude/agents/
!.claude/hooks/
!.claude/skills/

# Codebook
codebook.toml

# Zsh runtime files
.zsh_history
.zsh_sessions/
.zcompdump*
.zsh_completions/

# Local-only files
.DS_Store
.editorconfig

# Assets
assets/

# Wallpapers
assets/wallpapers/

# SE
assets/se/

# Repository documentation files (should NOT be synced to HOME)
# These are documentation for the chezmoi repository itself
MIGRATION.md
README.md
# Project-scope instructions for Claude Code working in this repo; deploying it
# would drop a stray ~/CLAUDE.md that every session under HOME would load
CLAUDE.md
TROUBLESHOOTING.md

# Brewfile stays in chezmoi source directory only
# Avoid accidental edits in HOME directory
Brewfile

# Lefthook config governs this repo's own hooks; not a dotfile to deploy
lefthook.yml
.markdownlint-cli2.jsonc
ruff.toml
_typos.toml

# Tests for scripts in this repo; run from the source checkout, never deployed
tests/

# Bytecode left behind when the tests import ambient-daily; deploying it would
# drop a stale cache next to the script in ~/.local/bin
**/__pycache__

# Ambient Context and its LaunchAgent exist only on macOS
{{ if ne .chezmoi.os "darwin" }}
Library/
.local/bin/ambient-daily
.config/ambient-daily/
{{ end }}
