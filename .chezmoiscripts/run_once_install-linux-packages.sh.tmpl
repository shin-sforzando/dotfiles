{{- if and (eq .chezmoi.os "linux") (eq .chezmoi.osRelease.id "debian") -}}
#!/bin/bash

set -eufo pipefail

echo "🐧 Installing Linux GUI applications..."

# Ensure we have required tools
if ! command -v curl &>/dev/null; then
  echo "❌ curl is required but not installed"
  exit 1
fi

# Create keyrings directory if it doesn't exist
sudo mkdir -p /usr/share/keyrings

# =============================================================================
# Visual Studio Code
# https://code.visualstudio.com/docs/setup/linux
# =============================================================================
if ! command -v code &>/dev/null; then
  echo "📝 Installing Visual Studio Code..."

  # Download and install Microsoft GPG key
  curl -fsSL https://packages.microsoft.com/keys/microsoft.asc | \
    gpg --dearmor | \
    sudo tee /usr/share/keyrings/microsoft-vscode.gpg >/dev/null

  # Add VSCode repository (DEB822 format)
  cat <<'EOF' | sudo tee /etc/apt/sources.list.d/vscode.sources
Types: deb
URIs: https://packages.microsoft.com/repos/code
Suites: stable
Components: main
Architectures: amd64 arm64 armhf
Signed-By: /usr/share/keyrings/microsoft-vscode.gpg
EOF

  sudo apt update
  sudo apt install -y code
  echo "✅ Visual Studio Code installed"
else
  echo "⏭️  Visual Studio Code already installed"
fi

# =============================================================================
# Vivaldi Browser
# https://help.vivaldi.com/desktop/install-update/manual-setup-vivaldi-linux-repositories/
# =============================================================================
if ! command -v vivaldi &>/dev/null; then
  echo "🌐 Installing Vivaldi Browser..."

  # Download and install Vivaldi GPG key
  curl -fsSL https://repo.vivaldi.com/archive/linux_signing_key.pub | \
    gpg --dearmor | \
    sudo tee /usr/share/keyrings/vivaldi.gpg >/dev/null

  # Add Vivaldi repository (DEB822 format)
  cat <<'EOF' | sudo tee /etc/apt/sources.list.d/vivaldi.sources
Types: deb
URIs: https://repo.vivaldi.com/archive/deb/
Suites: stable
Components: main
Architectures: amd64 arm64 armhf
Signed-By: /usr/share/keyrings/vivaldi.gpg
EOF

  sudo apt update
  sudo apt install -y vivaldi-stable
  echo "✅ Vivaldi Browser installed"
else
  echo "⏭️  Vivaldi Browser already installed"
fi

# =============================================================================
# Ghostty Terminal Emulator
# https://debian.griffo.io/
# =============================================================================
if ! command -v ghostty &>/dev/null; then
  echo "👻 Installing Ghostty Terminal..."

  # Add debian.griffo.io repository (provides Ghostty and other dev tools)
  curl -fsSL https://debian.griffo.io/EA0F721D231FDD3A0A17B9AC7808B4DD62C41256.asc | \
    gpg --dearmor | \
    sudo tee /usr/share/keyrings/debian-griffo.gpg >/dev/null

  # Add repository (DEB822 format)
  cat <<EOF | sudo tee /etc/apt/sources.list.d/debian-griffo.sources
Types: deb
URIs: https://debian.griffo.io/apt
Suites: $(lsb_release -sc 2>/dev/null || echo trixie)
Components: main
Signed-By: /usr/share/keyrings/debian-griffo.gpg
EOF

  sudo apt update
  sudo apt install -y ghostty
  echo "✅ Ghostty installed"
else
  echo "⏭️  Ghostty already installed"
fi

# =============================================================================
# OpenSSH Server
# =============================================================================
if ! dpkg -l openssh-server 2>/dev/null | grep -q "^ii"; then
  echo "🔐 Installing OpenSSH Server..."
  sudo apt install -y openssh-server
  echo "✅ OpenSSH Server installed"
else
  echo "⏭️  OpenSSH Server already installed"
fi

# =============================================================================
# x11vnc
# =============================================================================
if ! command -v x11vnc &>/dev/null; then
  echo "🖥️ Installing x11vnc..."
  sudo apt install -y x11vnc
  echo "✅ x11vnc installed"
else
  echo "⏭️  x11vnc already installed"
fi

# =============================================================================
# libnotify (for desktop notifications via notify-send)
# =============================================================================
if ! command -v notify-send &>/dev/null; then
  echo "🔔 Installing libnotify..."
  sudo apt install -y libnotify-bin
  echo "✅ libnotify installed"
else
  echo "⏭️  libnotify already installed"
fi

# =============================================================================
# Docker Desktop
# https://docs.docker.com/desktop/setup/install/linux/debian/
# =============================================================================

# Set up Docker repository if not already configured
if [[ ! -f /usr/share/keyrings/docker.gpg ]]; then
  echo "🐳 Setting up Docker repository..."

  # Install required packages
  sudo apt install -y ca-certificates gnupg

  # Add Docker's official GPG key
  curl -fsSL https://download.docker.com/linux/debian/gpg | \
    sudo gpg --dearmor -o /usr/share/keyrings/docker.gpg
  sudo chmod a+r /usr/share/keyrings/docker.gpg

  # Add Docker repository (DEB822 format)
  cat <<EOF | sudo tee /etc/apt/sources.list.d/docker.sources
Types: deb
URIs: https://download.docker.com/linux/debian
Suites: $(. /etc/os-release && echo "$VERSION_CODENAME")
Components: stable
Architectures: amd64
Signed-By: /usr/share/keyrings/docker.gpg
EOF

  sudo apt update
  echo "✅ Docker repository configured"
fi

# Install Docker Desktop
if ! dpkg -l docker-desktop 2>/dev/null | grep -q "^ii"; then
  echo "🐳 Installing Docker Desktop..."

  # Install gnome-terminal (required for non-GNOME environments)
  if ! command -v gnome-terminal &>/dev/null; then
    sudo apt install -y gnome-terminal
  fi

  # Download and install Docker Desktop DEB package
  DOCKER_DESKTOP_DEB="/tmp/docker-desktop-amd64.deb"
  curl -fsSL -o "${DOCKER_DESKTOP_DEB}" \
    "https://desktop.docker.com/linux/main/amd64/docker-desktop-amd64.deb"
  sudo apt install -y "${DOCKER_DESKTOP_DEB}"
  rm -f "${DOCKER_DESKTOP_DEB}"

  # Add current user to docker group
  if ! groups "${USER}" | grep -q '\bdocker\b'; then
    sudo usermod -aG docker "${USER}"
    echo "⚠️  Added ${USER} to docker group - please log out and back in"
  fi

  echo "✅ Docker Desktop installed"
else
  echo "⏭️  Docker Desktop already installed"
fi

echo ""
echo "✅ Linux packages installation completed!"
{{ end -}}
