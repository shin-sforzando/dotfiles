{{- if eq .chezmoi.os "darwin" -}}
{{- /* The installed branch must render byte-for-byte as before: any change to the
output re-runs this script, and a rebuilt applet loses its privacy grants. */ -}}
{{- if includeTemplate "ambient-context-installed" . -}}
#!/bin/bash
# plist hash: {{ include "private_Library/LaunchAgents/jp.co.sforzando.ambient-daily.plist.tmpl" | sha256sum }}

set -eufo pipefail

label="jp.co.sforzando.ambient-daily"
plist="$HOME/Library/LaunchAgents/$label.plist"
app="$HOME/Applications/AmbientDaily.app"

# Privacy protection (TCC) silently denies a launchd-spawned interpreter access
# to ~/Documents and iCloud Drive, and granting python3 itself would cover every
# script. A dedicated applet gets its own grant, and the script it runs inherits it.
echo "🔨 Building $app..."
mkdir -p "$HOME/Applications"
rm -rf "$app"
osacompile -o "$app" <<'APPLESCRIPT'
try
  -- The script reports failures itself; swallowing the error here keeps the
  -- applet from raising a modal dialog on every failed background run.
  do shell script "\"$HOME/.local/bin/ambient-daily\" >> \"$HOME/Library/Logs/ambient-daily.log\" 2>&1"
end try
APPLESCRIPT
plutil -replace CFBundleIdentifier -string "$label" "$app/Contents/Info.plist"
# Background-only: no Dock icon or menu bar flash at 06:00.
plutil -replace LSUIElement -bool true "$app/Contents/Info.plist"
# Editing Info.plist invalidates the signature osacompile applied, and TCC keys grants to it.
codesign --force --sign - "$app"

# launchd keeps the plist it loaded, so a changed file only takes effect after a reload.
echo "🔄 Reloading $label LaunchAgent..."
launchctl bootout "gui/$(id -u)/$label" 2>/dev/null || true
launchctl bootstrap "gui/$(id -u)" "$plist"
echo "✅ $label loaded"
echo "🔐 On first run, allow AmbientDaily to access Documents and iCloud Drive"
{{- else -}}
#!/bin/bash

set -eufo pipefail

# Ambient Context is not installed here, so there is no KB to read and a copy of
# ambient-daily deployed before it was gated would fail and notify every morning.
# .chezmoiignore stops further deploys, but chezmoi never removes an ignored target
# (not even one listed in .chezmoiremove), launchd keeps a loaded job until it is
# booted out, and the applet is built rather than deployed: all of it goes here.
label="jp.co.sforzando.ambient-daily"
if launchctl print "gui/$(id -u)/$label" &>/dev/null; then
  echo "🧹 Unloading $label (Ambient Context is not installed)..."
  launchctl bootout "gui/$(id -u)/$label" || true
fi
rm -rf "$HOME/Applications/AmbientDaily.app" \
  "$HOME/Library/LaunchAgents/$label.plist" \
  "$HOME/.local/bin/ambient-daily" \
  "$HOME/.config/ambient-daily"
{{- end }}
{{- end }}
