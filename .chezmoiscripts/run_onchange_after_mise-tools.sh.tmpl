#!/bin/bash
# config-hash: {{ include "private_dot_config/mise/config.toml" | sha256sum }}

set -eufo pipefail

if ! command -v mise &>/dev/null; then
  echo "mise not found, skipping mise tool installation"
  exit 0
fi

# npm-backend CLIs land in mise's own install dir (node-version-independent),
# so they stay on PATH regardless of a repo's pinned node — unlike `npm -g`.
echo "📦 Installing mise tools (node + npm-backend CLIs)..."
mise install

# cz-emoji is a no-bin commitizen adapter, so it cannot be an npm-backend tool.
# Install it into a fixed, node-version-independent prefix that ~/.czrc references
# by absolute path — so it survives LTS node upgrades without a reinstall trigger.
# node@lts is only the runner here; the install target is the fixed prefix.
echo "📦 Installing cz-emoji for commitizen..."
mise exec node@lts -- npm install --global --prefix "${HOME}/.local/share/cz-emoji" cz-emoji

echo "✅ mise tools installed."
