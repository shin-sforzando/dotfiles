#!/bin/bash
# tirith version: {{ with lookPath "tirith" }}{{ output . "--version" | trim }}{{ end }}

set -eufo pipefail

# Regenerate the version-specific Claude Code hook script (~/.claude/hooks/tirith-check.py)
# referenced by the PreToolUse hook in ~/.claude/settings.json. --update-configs only
# refreshes the embedded hook script; it does not touch settings.json or shell profiles,
# so the generated artifact stays out of source control while the declared references live
# in private_dot_claude/settings.json.
if ! command -v tirith &>/dev/null; then
  echo "⚠️  tirith not found, skipping Claude Code hook script generation"
  exit 0
fi

echo "🛡️  Refreshing tirith Claude Code hook script..."
tirith setup claude-code --update-configs --scope user --quiet
echo "✅ tirith Claude Code hook script up to date."
