#!/bin/bash

set -eufo pipefail

# Re-run this script whenever the Brewfile changes:
# Brewfile hash: {{ include "Brewfile" | sha256sum }}

echo "📦 Installing packages..."

# Homebrew / Linuxbrew installation check
if ! command -v brew &>/dev/null; then
  echo "🍺 Installing Homebrew..."
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi

# Install packages from Brewfile (taps are declared in the Brewfile itself)
# Use CHEZMOI_SOURCE_DIR since dotfiles haven't been applied yet
BREWFILE="${CHEZMOI_SOURCE_DIR:-$HOME/.local/share/chezmoi}/Brewfile"
if [ -f "$BREWFILE" ]; then
  # Trust non-official taps referenced in the Brewfile before bundling,
  # since Homebrew refuses to load untrusted taps when HOMEBREW_REQUIRE_TAP_TRUST is set.
  echo "🔐 Trusting non-official taps from Brewfile..."
  while IFS= read -r tap; do
    [ -n "$tap" ] && brew trust --tap "$tap"
  done < <(
    {
      grep -E '^[[:space:]]*tap[[:space:]]+"' "$BREWFILE" \
        | sed -E 's/^[[:space:]]*tap[[:space:]]+"([^"]+)".*/\1/'
      grep -E '^[[:space:]]*(brew|cask)[[:space:]]+"[^"]+/[^"]+/[^"]+"' "$BREWFILE" \
        | sed -E 's#^[[:space:]]*(brew|cask)[[:space:]]+"([^"/]+/[^"/]+)/[^"]+".*#\2#'
    } | tr '[:upper:]' '[:lower:]' | sort -u
  )

  echo "📦 Installing Homebrew packages..."
  brew bundle --file="$BREWFILE"
fi

# Rust: Install cargo-update
if command -v cargo &>/dev/null; then
  echo "🦀 Installing cargo-update..."
  cargo install cargo-update
fi

# Neovim Python provider
if command -v uv &>/dev/null; then
  echo "📝 Installing Neovim Python provider (using uv)..."
  uv tool install pynvim
elif command -v pip3 &>/dev/null; then
  echo "📝 Installing Neovim Python provider (pip3 fallback)..."
  pip3 install --user pynvim
fi

# Create Workspace directory for ghq
echo "📁 Creating Workspace directory..."
mkdir -p "$HOME/Workspace"

{{ if eq .chezmoi.os "darwin" -}}
# .DS_Store on network drives
echo "🗂️ Configuring .DS_Store settings..."
defaults write com.apple.desktopservices DSDontWriteNetworkStores True 2>/dev/null || true
{{ end -}}

echo ""
echo "🔐 Manual steps required:"
echo "  1. GPG key setup:"
echo "     gpg --keyserver hkps://keys.openpgp.org --search-keys shin@sforzando.co.jp"
echo "     gpg --edit-key KEYID"
echo "     > trust"
echo ""
echo "  2. Atuin shell history sync:"
echo "     atuin login"
echo "     atuin sync"
echo ""
echo "  3. Set default shell:"
{{ if eq .chezmoi.os "darwin" -}}
echo "     sudo chsh -s \$(brew --prefix)/bin/zsh"
{{ else -}}
echo "     chsh -s \$(which zsh)"
{{ end -}}
echo ""

echo "✅ Package installation completed!"
