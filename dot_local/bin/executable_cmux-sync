#!/bin/bash
# cmux-sync: carry the cmux workspace layout (groups, order, color, cwd, title)
# between Macs through a snapshot file in iCloud Drive.
#
# Written for /bin/bash 3.2 so it needs no Homebrew bash and shellcheck can lint it
# (shellcheck cannot parse zsh). jq does the JSON work; this file only orchestrates.

set -euo pipefail

SYNC_DIR="${CMUX_SYNC_DIR:-$HOME/Library/Mobile Documents/com~apple~CloudDocs/cmux-sync}"
STATE_DIR="${CMUX_SYNC_STATE_DIR:-$HOME/.local/state/cmux-sync}"
SNAPSHOT="$SYNC_DIR/snapshot.json"
LOG_FILE="$STATE_DIR/last-pull.log"
# iCloud may still be fetching a snapshot that the other Mac wrote seconds ago
DOWNLOAD_TIMEOUT="${CMUX_SYNC_DOWNLOAD_TIMEOUT:-30}"
CLONE_JOBS=4
# A fresh value per run keeps group idempotency keys from matching an earlier pull
RUN_ID="$(date +%s)-$$"

PHASE=init
CREATED=""
CLONE_FAILED=""
PENDING=""
DIRS=()

# Keeps cmux's deprecation and hint chatter out of output that jq parses
export CMUX_QUIET=1

SCHEMA_VERSION=1

# Every assumption about cmux's JSON field names lives here, so a cmux update
# that renames a field only needs these definitions changed.
JQ_DEFS='
def ws_items: if type == "array" then . else .workspaces end;
def grp_items: .groups // [];
def grp_members: .member_workspace_refs;
def grp_color: .custom_color;
def grp_icon: .icon_symbol;
def grp_collapsed: .is_collapsed // false;
def new_grp_id: .group.ref;
'

usage() {
  cat <<'EOF'
usage: cmux-sync <command>

  push                 save this Mac's workspace layout to iCloud Drive
  pull [--yes] [--dry-run] [--from <file>]
                       replace this Mac's workspaces with the saved layout
  show [<file>]        print the saved layout without touching cmux
EOF
}

die() {
  printf 'cmux-sync: %s\n' "$*" >&2
  exit 1
}

warn() {
  printf 'cmux-sync: warning: %s\n' "$*" >&2
}

# The caller's workspace may close at the end of a pull, taking the terminal
# output with it, so anything worth reading afterwards also goes to the log file
log() {
  mkdir -p "$STATE_DIR"
  printf '%s\n' "$*" | tee -a "$LOG_FILE" >&2
}

notify() {
  cmux notify --title "$1" --body "$2" >/dev/null 2>&1 || true
}

from_tilde() {
  case "$1" in
    "~") printf '%s\n' "$HOME" ;;
    \~/*) printf '%s/%s\n' "$HOME" "${1#\~/}" ;;
    *) printf '%s\n' "$1" ;;
  esac
}

nearest_dir() {
  local dir=$1
  while [ ! -d "$dir" ]; do
    dir=$(dirname "$dir")
  done
  printf '%s\n' "$dir"
}

# iCloud keeps evicted or not-yet-synced files as ".<name>.icloud" placeholders
ensure_local() {
  local file=$1 placeholder waited=0
  [ -f "$file" ] && return 0
  placeholder="$(dirname "$file")/.$(basename "$file").icloud"
  if [ ! -f "$placeholder" ]; then
    # Only the default snapshot comes from a push; any other path is the user's own file
    [ "$file" = "$SNAPSHOT" ] || die "no such file: $file"
    die "no snapshot at $file; run 'cmux-sync push' on the other Mac first"
  fi
  brctl download "$file" >/dev/null 2>&1 || true
  while [ ! -f "$file" ]; do
    [ "$waited" -lt "$DOWNLOAD_TIMEOUT" ] || die "iCloud did not download $file within ${DOWNLOAD_TIMEOUT}s"
    sleep 1
    waited=$((waited + 1))
  done
}

# Prints host/owner/name when the directory belongs to a ghq checkout, nothing otherwise
repo_of() {
  local dir=$1 root=$2 main
  case "$dir" in
    "$root"/*) main=$dir ;;
    *)
      # A worktree outside the ghq root still shares its main clone's git dir
      main=$(git -C "$dir" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || return 0
      main=${main%/.git}
      ;;
  esac
  case "$main" in
    "$root"/*) ;;
    *) return 0 ;;
  esac
  # ghq lays clones out as host/owner/name, so anything shallower is not a repository
  printf '%s\n' "${main#"$root"/}" | awk -F/ 'NF >= 3 { print $1 "/" $2 "/" $3 }'
}

build_snapshot() {
  local root ws groups windows remote_count repos='{}' dir repo
  # bash 3.2 has no inherit_errexit, so callers that capture this function with
  # $(...) never stop on a failing command inside it; every external read returns
  # explicitly instead, or a dead ghq turns every path into a bogus repo slug
  root=$(ghq root) || return 1
  ws=$(cmux workspace list --json) || return 1
  groups=$(cmux workspace-group list --json) || return 1

  windows=$(cmux tree --json | jq '[.windows[] | select(.workspace_count > 0)] | length') || return 1
  [ "$windows" -le 1 ] || warn "$windows windows have workspaces; only the current window is captured"
  remote_count=$(jq "$JQ_DEFS"'[ws_items[] | select(.remote.enabled // false)] | length' <<<"$ws")
  [ "$remote_count" -eq 0 ] || warn "skipping $remote_count remote workspace(s); SSH and cloud VM sessions cannot be recreated"

  while IFS= read -r dir; do
    [ -n "$dir" ] || continue
    repo=$(repo_of "$dir" "$root")
    repos=$(jq -c --arg d "$dir" --arg r "$repo" '. + {($d): (if $r == "" then null else $r end)}' <<<"$repos")
  done < <(jq -r "$JQ_DEFS"'ws_items[].current_directory // empty' <<<"$ws")

  jq -n \
    --argjson ws "$ws" --argjson gs "$groups" --argjson repos "$repos" \
    --arg host "$(scutil --get LocalHostName)" \
    --arg now "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    --arg home "$HOME" --argjson version "$SCHEMA_VERSION" \
    "$JQ_DEFS"'
    def tilde:
      if . == $home then "~"
      elif startswith($home + "/") then "~" + .[($home | length):]
      else . end;
    [$gs | grp_items | to_entries[] | {key: "g\(.key + 1)", g: .value}] as $keyed
    | ([$keyed[] | .key as $k | .g | grp_members[] | {(.): $k}] | add // {}) as $group_of
    | ($ws | ws_items | map(select((.remote.enabled // false) | not)) | sort_by(.index)) as $local
    | {
        version: $version,
        createdAt: $now,
        host: $host,
        groups: [$keyed[] | {
          key,
          name: .g.name,
          color: (.g | grp_color),
          icon: (.g | grp_icon),
          collapsed: (.g | grp_collapsed)
        }],
        workspaces: [$local[] | {
          title: (if .has_custom_title then .custom_title else null end),
          color: .custom_color,
          # Browser-only workspaces, or shells that have not reported yet, have no directory
          cwd: (.current_directory | if . == null then null else tilde end),
          repo: (if .current_directory == null then null else $repos[.current_directory] end),
          group: ($group_of[.ref] // null),
          pinned: (.pinned // false),
          description: .description,
          selected: (.selected // false)
        }]
      }'
}

cmd_push() {
  local snapshot tmp summary
  snapshot=$(build_snapshot) || die "could not read the current layout from cmux or ghq; nothing was pushed"
  mkdir -p "$SYNC_DIR"
  # Rename into place so iCloud never uploads a half-written snapshot
  tmp="$SYNC_DIR/.snapshot.json.tmp.$$"
  printf '%s\n' "$snapshot" >"$tmp"
  mv "$tmp" "$SNAPSHOT"
  summary=$(jq -r '"pushed \(.workspaces | length) workspaces and \(.groups | length) groups from \(.host)"' <<<"$snapshot")
  printf '%s\n' "$summary"
  # The palette action closes its tab on success, so the terminal output is never seen
  notify "cmux-sync push" "$summary"
}

# Decides where each snapshot workspace opens on this Mac. Fills DIRS (left empty
# for repos that still need cloning) and PENDING (newline-separated repos to clone).
resolve_dirs() {
  local snap=$1 root=$2 count i cwd repo
  count=$(jq '.workspaces | length' <<<"$snap")
  DIRS=()
  PENDING=""
  for ((i = 0; i < count; i++)); do
    cwd=$(jq -r ".workspaces[$i].cwd // empty" <<<"$snap")
    # A workspace saved without a directory would otherwise resolve to the relative path "."
    cwd=$(from_tilde "${cwd:-~}")
    repo=$(jq -r ".workspaces[$i].repo // empty" <<<"$snap")
    if [ -d "$cwd" ]; then
      DIRS[i]=$cwd
    elif [ -n "$repo" ] && [ -d "$root/$repo" ]; then
      # The worktree or subdirectory lives only on the other Mac; the main clone is a fine start
      DIRS[i]=$root/$repo
    elif [ -n "$repo" ]; then
      DIRS[i]=""
      PENDING="$PENDING$repo"$'\n'
    else
      DIRS[i]=$(nearest_dir "$cwd")
    fi
  done
}

# A failed clone falls back to the nearest existing parent so the workspace keeps
# its place in the order and its group instead of disappearing
clone_pending() {
  local snap=$1 root=$2 count i repo
  [ -n "$PENDING" ] || return 0
  # A private repo with no stored credential makes git ask for a password on the
  # terminal, and with output discarded the pull just hangs. Failing fast instead
  # sends it down the nearest-parent fallback and into the report.
  printf '%s' "$PENDING" | sort -u |
    GIT_TERMINAL_PROMPT=0 GIT_SSH_COMMAND="ssh -o BatchMode=yes" \
      xargs -P "$CLONE_JOBS" -n 1 ghq get >/dev/null 2>&1 || true
  count=$(jq '.workspaces | length' <<<"$snap")
  for ((i = 0; i < count; i++)); do
    [ -z "${DIRS[i]}" ] || continue
    repo=$(jq -r ".workspaces[$i].repo" <<<"$snap")
    if [ -d "$root/$repo" ]; then
      DIRS[i]=$root/$repo
    else
      DIRS[i]=$(nearest_dir "$root/$repo")
      CLONE_FAILED="$CLONE_FAILED $repo"
    fi
  done
}

print_plan() {
  local snap=$1 root=$2 count i dir title
  count=$(jq '.workspaces | length' <<<"$snap")
  printf '%s' "$PENDING" | sort -u | sed '/^$/d; s/^/would clone /'
  for ((i = 0; i < count; i++)); do
    dir=${DIRS[i]}
    [ -n "$dir" ] || dir="$root/$(jq -r ".workspaces[$i].repo" <<<"$snap")"
    title=$(jq -r ".workspaces[$i].title // \"(auto title)\"" <<<"$snap")
    printf 'would create %s at %s\n' "$title" "$dir"
  done
}

create_workspace() {
  local dir=$1 title=$2 description=$3 id
  local -a args=(new-workspace --cwd "$dir" --focus false)
  [ -z "$title" ] || args+=(--name "$title")
  [ -z "$description" ] || args+=(--description "$description")
  # new-workspace answers "OK workspace:<n>" even with --json; the ref works wherever an id does
  id=$(cmux "${args[@]}" | awk '$1 == "OK" { print $2; exit }')
  [ -n "$id" ] || die "cmux new-workspace returned no workspace id"
  printf '%s\n' "$id"
}

on_exit() {
  local rc=$?
  [ "$rc" -ne 0 ] || return 0
  case "$PHASE" in
    create)
      log "aborted before closing anything; your previous workspaces are untouched. created so far:${CREATED:- none}"
      notify "cmux-sync pull aborted" "see $LOG_FILE"
      ;;
    close)
      log "failed while closing the previous workspaces; the new layout is already in place"
      notify "cmux-sync pull incomplete" "see $LOG_FILE"
      ;;
  esac
}

apply_pull() {
  local snap=$1 count gcount i g id key members gid value self old_ids selected
  local -a new_ids=()
  count=$(jq '.workspaces | length' <<<"$snap")
  gcount=$(jq '.groups | length' <<<"$snap")

  mkdir -p "$STATE_DIR"
  : >"$LOG_FILE"
  # Keep one earlier backup: an undo via --from reads before-pull.json, and a failed
  # undo must not leave the only copy of the original layout overwritten
  if [ -f "$STATE_DIR/before-pull.json" ]; then
    mv "$STATE_DIR/before-pull.json" "$STATE_DIR/before-pull.prev.json"
  fi
  build_snapshot >"$STATE_DIR/before-pull.json"
  log "saved the current layout to $STATE_DIR/before-pull.json (undo with: cmux-sync pull --from that file)"
  old_ids=$(cmux workspace list --json | jq -r "$JQ_DEFS"'ws_items[].id')

  PHASE=create
  trap on_exit EXIT
  for ((i = 0; i < count; i++)); do
    id=$(create_workspace "${DIRS[i]}" \
      "$(jq -r ".workspaces[$i].title // empty" <<<"$snap")" \
      "$(jq -r ".workspaces[$i].description // empty" <<<"$snap")")
    new_ids[i]=$id
    CREATED="$CREATED $id"
    value=$(jq -r ".workspaces[$i].color // empty" <<<"$snap")
    [ -z "$value" ] || cmux workspace-action --action set-color --workspace "$id" --color "$value" >/dev/null
    value=$(jq -r ".workspaces[$i].pinned" <<<"$snap")
    [ "$value" != true ] || cmux workspace-action --action pin --workspace "$id" >/dev/null
  done

  for ((g = 0; g < gcount; g++)); do
    key=$(jq -r ".groups[$g].key" <<<"$snap")
    members=""
    for ((i = 0; i < count; i++)); do
      [ "$(jq -r ".workspaces[$i].group // empty" <<<"$snap")" = "$key" ] || continue
      members="${members:+$members,}${new_ids[i]}"
    done
    [ -n "$members" ] || continue
    gid=$(cmux workspace-group create \
      --name "$(jq -r ".groups[$g].name // \"Group\"" <<<"$snap")" \
      --from "$members" \
      --idempotency-key "cmux-sync-$RUN_ID-$key" --json | jq -r "$JQ_DEFS"'new_grp_id // empty')
    [ -n "$gid" ] || die "cmux workspace-group create returned no group id"
    value=$(jq -r ".groups[$g].color // empty" <<<"$snap")
    [ -z "$value" ] || cmux workspace-group set-color "$gid" --hex "$value" >/dev/null
    value=$(jq -r ".groups[$g].icon // empty" <<<"$snap")
    [ -z "$value" ] || cmux workspace-group set-icon "$gid" --symbol "$value" >/dev/null
    value=$(jq -r ".groups[$g].collapsed" <<<"$snap")
    [ "$value" != true ] || cmux workspace-group collapse "$gid" >/dev/null
  done

  cmux reorder-workspaces --order "$(
    IFS=,
    printf '%s' "${new_ids[*]}"
  )" >/dev/null

  PHASE=close
  self=${CMUX_WORKSPACE_ID:-}
  while IFS= read -r id; do
    if [ -z "$id" ] || [ "$id" = "$self" ]; then
      continue
    fi
    # --force: the user already agreed to close every workspace, including ones running a process
    cmux close-workspace --workspace "$id" --force >/dev/null || log "could not close workspace $id; close it by hand"
  done <<<"$old_ids"
  selected=$(jq '[.workspaces[].selected] | index(true) // empty' <<<"$snap")
  [ -z "$selected" ] || cmux select-workspace --workspace "${new_ids[selected]}" >/dev/null

  PHASE=finished
  log "created $count workspaces and $gcount groups from $(jq -r .host <<<"$snap")"
  [ -z "$CLONE_FAILED" ] || log "clone failed:$CLONE_FAILED (opened at the nearest existing parent)"
  notify "cmux-sync pull" "$count workspaces from $(jq -r .host <<<"$snap")"
  # Closing the caller ends this shell, so it has to be the very last command
  if [ -n "$self" ] && grep -qxF -- "$self" <<<"$old_ids"; then
    cmux close-workspace --workspace "$self" --force >/dev/null
  fi
}

cmd_pull() {
  local assume_yes=0 dry_run=0 file=$SNAPSHOT snap version count host root answer
  while [ $# -gt 0 ]; do
    case "$1" in
      --yes) assume_yes=1 ;;
      --dry-run) dry_run=1 ;;
      --from)
        [ $# -ge 2 ] || die "--from needs a file"
        file=$2
        shift
        ;;
      *) die "unknown option for pull: $1" ;;
    esac
    shift
  done

  ensure_local "$file"
  snap=$(cat "$file")
  version=$(jq -r '.version' <<<"$snap")
  [ "$version" = "$SCHEMA_VERSION" ] || die "snapshot version $version is not supported (expected $SCHEMA_VERSION)"
  count=$(jq '.workspaces | length' <<<"$snap")
  # Applying an empty snapshot would close every workspace and leave nothing behind
  [ "$count" -gt 0 ] || die "snapshot has no workspaces; refusing to close everything"
  host=$(jq -r '.host' <<<"$snap")
  [ "$host" != "$(scutil --get LocalHostName)" ] || warn "this snapshot was saved on this Mac ($host)"

  root=$(ghq root)
  resolve_dirs "$snap" "$root"
  # Age rather than a timestamp, so a snapshot left over from days ago stands out
  jq -r '((now - (.createdAt | fromdateiso8601)) / 60 | floor) as $age
    | "pull \(.workspaces | length) workspaces and \(.groups | length) groups saved on \(.host) \($age) min ago"' <<<"$snap"
  if [ "$dry_run" -eq 1 ]; then
    print_plan "$snap" "$root"
    return 0
  fi
  if [ -n "$PENDING" ]; then
    printf 'will clone with ghq:\n'
    printf '%s' "$PENDING" | sort -u | sed '/^$/d; s/^/  /'
  fi
  if [ "$assume_yes" -ne 1 ]; then
    printf 'every workspace in this window closes after the new ones are created. continue? [y/N] '
    read -r answer || answer=""
    case "$answer" in
      y | Y | yes) ;;
      *) die "aborted; nothing was changed" ;;
    esac
  fi

  clone_pending "$snap" "$root"
  apply_pull "$snap"
}

cmd_show() {
  local file=${1:-$SNAPSHOT}
  ensure_local "$file"
  jq -r '
    . as $s
    | ((now - (.createdAt | fromdateiso8601)) / 60 | floor) as $age
    | "from \(.host), \($age) min ago, \(.workspaces | length) workspaces, \(.groups | length) groups",
      (.workspaces[]
        | (if .selected then "*" else " " end) as $mark
        | (if .group then (.group as $g | "  [" + ([$s.groups[] | select(.key == $g) | .name][0] // $g) + "]") else "" end) as $grp
        | "\($mark) \(.title // "(auto title)")  \(.cwd)\($grp)")
  ' "$file"
}

main() {
  if [ $# -lt 1 ]; then
    usage >&2
    exit 2
  fi
  local cmd=$1
  shift
  case "$cmd" in
    push) cmd_push "$@" ;;
    pull) cmd_pull "$@" ;;
    show) cmd_show "$@" ;;
    -h | --help | help) usage ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
}

main "$@"
