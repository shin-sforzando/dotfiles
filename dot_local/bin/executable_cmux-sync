#!/bin/bash
# cmux-sync: carry the cmux workspace layout (groups, order, color, cwd, title)
# between Macs through a snapshot file in iCloud Drive.
#
# Written for /bin/bash 3.2 so it needs no Homebrew bash and shellcheck can lint it
# (shellcheck cannot parse zsh). jq does the JSON work; this file only orchestrates.

set -euo pipefail

SYNC_DIR="${CMUX_SYNC_DIR:-$HOME/Library/Mobile Documents/com~apple~CloudDocs/cmux-sync}"
STATE_DIR="${CMUX_SYNC_STATE_DIR:-$HOME/.local/state/cmux-sync}"
SNAPSHOT="$SYNC_DIR/snapshot.json"
LOG_FILE="$STATE_DIR/last-pull.log"
# iCloud may still be fetching a snapshot that the other Mac wrote seconds ago
DOWNLOAD_TIMEOUT="${CMUX_SYNC_DOWNLOAD_TIMEOUT:-30}"

# Keeps cmux's deprecation and hint chatter out of output that jq parses
export CMUX_QUIET=1

SCHEMA_VERSION=1

# Every assumption about cmux's JSON field names lives here, so a cmux update
# that renames a field only needs these definitions changed.
JQ_DEFS='
def ws_items: if type == "array" then . else .workspaces end;
def grp_items: .groups // [];
def grp_members: .member_workspace_refs;
def grp_color: .custom_color;
def grp_icon: .icon_symbol;
def grp_collapsed: .is_collapsed // false;
'

usage() {
  cat <<'EOF'
usage: cmux-sync <command>

  push                 save this Mac's workspace layout to iCloud Drive
  pull [--yes] [--dry-run] [--from <file>]
                       replace this Mac's workspaces with the saved layout
  show [<file>]        print the saved layout without touching cmux
EOF
}

die() {
  printf 'cmux-sync: %s\n' "$*" >&2
  exit 1
}

warn() {
  printf 'cmux-sync: warning: %s\n' "$*" >&2
}

# The caller's workspace may close at the end of a pull, taking the terminal
# output with it, so anything worth reading afterwards also goes to the log file
log() {
  mkdir -p "$STATE_DIR"
  printf '%s\n' "$*" | tee -a "$LOG_FILE" >&2
}

notify() {
  cmux notify --title "$1" --body "$2" >/dev/null 2>&1 || true
}

from_tilde() {
  case "$1" in
    "~") printf '%s\n' "$HOME" ;;
    \~/*) printf '%s/%s\n' "$HOME" "${1#\~/}" ;;
    *) printf '%s\n' "$1" ;;
  esac
}

nearest_dir() {
  local dir=$1
  while [ ! -d "$dir" ]; do
    dir=$(dirname "$dir")
  done
  printf '%s\n' "$dir"
}

# iCloud keeps evicted or not-yet-synced files as ".<name>.icloud" placeholders
ensure_local() {
  local file=$1 placeholder waited=0
  [ -f "$file" ] && return 0
  placeholder="$(dirname "$file")/.$(basename "$file").icloud"
  [ -f "$placeholder" ] || die "no snapshot at $file; run 'cmux-sync push' on the other Mac first"
  brctl download "$file" >/dev/null 2>&1 || true
  while [ ! -f "$file" ]; do
    [ "$waited" -lt "$DOWNLOAD_TIMEOUT" ] || die "iCloud did not download $file within ${DOWNLOAD_TIMEOUT}s"
    sleep 1
    waited=$((waited + 1))
  done
}

# Prints host/owner/name when the directory belongs to a ghq checkout, nothing otherwise
repo_of() {
  local dir=$1 root=$2 main
  case "$dir" in
    "$root"/*) main=$dir ;;
    *)
      # A worktree outside the ghq root still shares its main clone's git dir
      main=$(git -C "$dir" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || return 0
      main=${main%/.git}
      ;;
  esac
  case "$main" in
    "$root"/*) ;;
    *) return 0 ;;
  esac
  # ghq lays clones out as host/owner/name, so anything shallower is not a repository
  printf '%s\n' "${main#"$root"/}" | awk -F/ 'NF >= 3 { print $1 "/" $2 "/" $3 }'
}

build_snapshot() {
  local root ws groups windows remote_count repos='{}' dir repo
  root=$(ghq root)
  ws=$(cmux workspace list --json)
  groups=$(cmux workspace-group list --json)

  windows=$(cmux tree --json | jq '[.windows[] | select(.workspace_count > 0)] | length')
  [ "$windows" -le 1 ] || warn "$windows windows have workspaces; only the current window is captured"
  remote_count=$(jq "$JQ_DEFS"'[ws_items[] | select(.remote.enabled // false)] | length' <<<"$ws")
  [ "$remote_count" -eq 0 ] || warn "skipping $remote_count remote workspace(s); SSH and cloud VM sessions cannot be recreated"

  while IFS= read -r dir; do
    [ -n "$dir" ] || continue
    repo=$(repo_of "$dir" "$root")
    repos=$(jq -c --arg d "$dir" --arg r "$repo" '. + {($d): (if $r == "" then null else $r end)}' <<<"$repos")
  done < <(jq -r "$JQ_DEFS"'ws_items[].current_directory // empty' <<<"$ws")

  jq -n \
    --argjson ws "$ws" --argjson gs "$groups" --argjson repos "$repos" \
    --arg host "$(scutil --get LocalHostName)" \
    --arg now "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    --arg home "$HOME" --argjson version "$SCHEMA_VERSION" \
    "$JQ_DEFS"'
    def tilde:
      if . == $home then "~"
      elif startswith($home + "/") then "~" + .[($home | length):]
      else . end;
    [$gs | grp_items | to_entries[] | {key: "g\(.key + 1)", g: .value}] as $keyed
    | ([$keyed[] | .key as $k | .g | grp_members[] | {(.): $k}] | add // {}) as $group_of
    | ($ws | ws_items | map(select((.remote.enabled // false) | not)) | sort_by(.index)) as $local
    | {
        version: $version,
        createdAt: $now,
        host: $host,
        groups: [$keyed[] | {
          key,
          name: .g.name,
          color: (.g | grp_color),
          icon: (.g | grp_icon),
          collapsed: (.g | grp_collapsed)
        }],
        workspaces: [$local[] | {
          title: (if .has_custom_title then .custom_title else null end),
          color: .custom_color,
          cwd: (.current_directory | tilde),
          repo: $repos[.current_directory],
          group: ($group_of[.ref] // null),
          pinned: (.pinned // false),
          description: .description,
          selected: (.selected // false)
        }]
      }'
}

cmd_push() {
  local snapshot tmp
  snapshot=$(build_snapshot)
  mkdir -p "$SYNC_DIR"
  # Rename into place so iCloud never uploads a half-written snapshot
  tmp="$SYNC_DIR/.snapshot.json.tmp.$$"
  printf '%s\n' "$snapshot" >"$tmp"
  mv "$tmp" "$SNAPSHOT"
  jq -r '"pushed \(.workspaces | length) workspaces and \(.groups | length) groups from \(.host)"' <<<"$snapshot"
}

cmd_show() {
  local file=${1:-$SNAPSHOT}
  ensure_local "$file"
  jq -r '
    . as $s
    | ((now - (.createdAt | fromdateiso8601)) / 60 | floor) as $age
    | "from \(.host), \($age) min ago, \(.workspaces | length) workspaces, \(.groups | length) groups",
      (.workspaces[]
        | (if .selected then "*" else " " end) as $mark
        | (if .group then (.group as $g | "  [" + ([$s.groups[] | select(.key == $g) | .name][0] // $g) + "]") else "" end) as $grp
        | "\($mark) \(.title // "(auto title)")  \(.cwd)\($grp)")
  ' "$file"
}

main() {
  if [ $# -lt 1 ]; then
    usage >&2
    exit 2
  fi
  local cmd=$1
  shift
  case "$cmd" in
    push) cmd_push "$@" ;;
    show) cmd_show "$@" ;;
    -h | --help | help) usage ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
}

main "$@"
