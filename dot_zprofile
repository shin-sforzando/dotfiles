#
# Executes commands at login pre-zshrc.
#

#
# Browser
#

if [[ -z "$BROWSER" && "$OSTYPE" == darwin* ]]; then
  export BROWSER='open'
fi

#
# Editors
#

if [[ -z "$EDITOR" ]]; then
  export EDITOR='nvim'
fi
if [[ -z "$VISUAL" ]]; then
  export VISUAL='code'
fi
if [[ -z "$PAGER" ]]; then
  export PAGER='less'
fi

#
# Language
#

if [[ -z "$LANG" ]]; then
  export LANG='en_US.UTF-8'
fi

#
# Paths
#

# Ensure path arrays do not contain duplicates.
typeset -gU cdpath fpath mailpath path

# Set user bin directories and standard locations if they exist
path=(
  $HOME/{,s}bin(N)
  /opt/{homebrew,local}/{,s}bin(N)
  /usr/local/{,s}bin(N)
  $path
)

# Homebrew
if [[ -e /opt/homebrew/bin/brew ]]; then
  # macOS (Apple Silicon)
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -e /home/linuxbrew/.linuxbrew/bin/brew ]]; then
  # Linux
  eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
fi

#
# mise
#

# `mise activate` lives in .zshrc, which only interactive shells read, while
# Homebrew's PATH lands here and again via /etc/paths.d/homebrew. That
# asymmetry let /opt/homebrew/bin/node shadow the pinned node in every
# non-interactive shell. Shims are plain PATH entries resolving the version at
# exec time, so they reach shells no hook ever runs in; .zshrc's `mise activate`
# still supersedes them once a shell is interactive. Must stay after the
# Homebrew block above, or Homebrew wins the prepend.
if (( $+commands[mise] )); then
  eval "$(mise activate zsh --shims)"
fi
