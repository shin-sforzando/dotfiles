## 1Password
#
if (( $+commands[op] )); then
  eval "$(op completion zsh)"
  compdef _op op
fi

## go-Task
#
if (( $+commands[task] )); then
  eval "$(task --completion zsh)"
fi

## tenv
#
if (( $+commands[tenv] )); then
  tenv completion zsh >| $PERSONAL_COMP_DIR/_tenv
