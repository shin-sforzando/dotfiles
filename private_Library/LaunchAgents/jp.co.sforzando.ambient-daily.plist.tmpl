<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Runs ambient-daily every morning. StartCalendarInterval fires once on wake
  when the Mac slept through 06:00, and RunAtLoad catches up after login.
  The script runs through AmbientDaily.app, launched with `open` so the app is
  its own responsible process and can hold the privacy (TCC) grants.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>jp.co.sforzando.ambient-daily</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/open</string>
    <string>-g</string>
    <string>{{ .chezmoi.homeDir }}/Applications/AmbientDaily.app</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>6</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>{{ .chezmoi.homeDir }}/Library/Logs/ambient-daily.log</string>
  <key>StandardErrorPath</key>
  <string>{{ .chezmoi.homeDir }}/Library/Logs/ambient-daily.log</string>
</dict>
</plist>
