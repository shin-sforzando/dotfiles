{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(cat *)",
      "Bash(cd /*)",
      "Bash(crit *)",
      "Bash(cut *)",
      "Bash(diff *)",
      "Bash(echo *)",
      "Bash(file *)",
      "Bash(find *)",
      "Bash(gh *)",
      "Bash(git blame *)",
      "Bash(git branch *)",
      "Bash(git describe *)",
      "Bash(git diff *)",
      "Bash(git fetch *)",
      "Bash(git log *)",
      "Bash(git remote *)",
      "Bash(git rev-parse *)",
      "Bash(git show *)",
      "Bash(git stash *)",
      "Bash(git status *)",
      "Bash(git switch *)",
      "Bash(grep *)",
      "Bash(head *)",
      "Bash(jq *)",
      "Bash(ls *)",
      "Bash(rg *)",
      "Bash(sort *)",
      "Bash(stat *)",
      "Bash(tail *)",
      "Bash(tree *)",
      "Bash(uniq *)",
      "Bash(wc *)",
      "LSP",
      "mcp__drawio__*",
      "mcp__playwright__*",
      "mcp__plugin_chrome-devtools-mcp_chrome-devtools__*",
      "mcp__plugin_context-mode_context-mode__*",
      "mcp__plugin_context-mode_context-mode__ctx_batch_execute",
      "mcp__plugin_context-mode_context-mode__ctx_execute",
      "mcp__plugin_context-mode_context-mode__ctx_execute_file",
      "mcp__plugin_context-mode_context-mode__ctx_fetch_and_index",
      "mcp__plugin_context7_context7__*",
      "mcp__plugin_figma_figma__*",
      "WebFetch",
      "WebSearch"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__plugin_context-mode_context-mode__ctx.*execute",
        "hooks": [
          {
            "type": "command",
            "command": "jq -c \u0027{systemMessage: ((.tool_name | sub(\u0022mcp__plugin_context-mode_context-mode__\u0022;\u0022\u0022)) \u002B \u0022:\\n\u0022 \u002B (if (.tool_input.commands | type) == \u0022array\u0022 then ([.tool_input.commands[]? | \u0022  \u2022 \u0022 \u002B (.label // \u0022\u0022) \u002B \u0022: \u0022 \u002B .command] | join(\u0022\\n\u0022)) else \u0022  \u0022 \u002B (if .tool_input.path then \u0022[\u0022 \u002B .tool_input.path \u002B \u0022] \u0022 else \u0022\u0022 end) \u002B \u0022(\u0022 \u002B (.tool_input.language // \u0022?\u0022) \u002B \u0022)\\n\u0022 \u002B (.tool_input.code // \u0022(no code)\u0022) end)), hookSpecificOutput: {hookEventName: \u0022PreToolUse\u0022, permissionDecision: \u0022allow\u0022, permissionDecisionReason: \u0022context-mode ctx_* auto-approved\u0022}}\u0027"
          }
        ]
      },
      {
        "matcher": "mcp__plugin_context-mode_context-mode__ctx_(fetch_and_index|search|index|stats|doctor|insight)",
        "hooks": [
          {
            "type": "command",
            "command": "jq -c \u0027{hookSpecificOutput: {hookEventName: \u0022PreToolUse\u0022, permissionDecision: \u0022allow\u0022, permissionDecisionReason: \u0022context-mode read-only ctx_* auto-approved\u0022}}\u0027"
          }
        ]
      },
      {
        "matcher": "mcp__drawio__(search_shapes|list_pages|get_page)",
        "hooks": [
          {
            "type": "command",
            "command": "jq -c \u0027{hookSpecificOutput: {hookEventName: \u0022PreToolUse\u0022, permissionDecision: \u0022allow\u0022, permissionDecisionReason: \u0022drawio read-only tool auto-approved\u0022}}\u0027"
          }
        ]
      },
      {
        "_pixtuoid": true,
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "PIXTUOID_SOURCE=claude-code \u0027pixtuoid-hook\u0027"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/bin/sidepulse hook-log --provider claude --log ~/.local/state/sidepulse/agent-monitor/claude.jsonl ; true"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "curl -s --connect-timeout 0.5 -m 5 -X POST --data-binary @- \u0022http://localhost:8765/hook?event=PreToolUse\u0026client=logi-claude-desktop\u0022; exit 0",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/notify.sh"
          }
        ]
      },
      {
        "_pixtuoid": true,
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "PIXTUOID_SOURCE=claude-code \u0027pixtuoid-hook\u0027"
