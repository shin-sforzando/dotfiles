# Font and appearance

font-family = "Mononoki Nerd Font Mono Regular"
font-size = 14
font-thicken = true
window-title-font-family = "Mononoki Nerd Font Mono Regular"
macos-titlebar-style = tabs
macos-option-as-alt = true

clipboard-read = allow
clipboard-write = allow
clipboard-trim-trailing-spaces = true
copy-on-select = true

# Disable automatic shell integration injection

# We manually load it in .zshrc to ensure correct hook order

shell-integration = none

window-padding-x = 8
window-padding-y = 16
window-padding-balance = true
window-save-state = always
window-new-tab-position = end

background-opacity = 0.75
background-opacity-cells = true

# unfocused-split-opacity = 0.5

# unfocused-split-fill = #000000

split-divider-color = #cccccc

# Notification

notify-on-command-finish = always
notify-on-command-finish-action = notify
notify-on-command-finish-after = 30s

# Working Directory Inheritance

window-inherit-working-directory = false
tab-inherit-working-directory = true
split-inherit-working-directory = true

quit-after-last-window-closed = true

macos-option-as-alt = left

# Newline for Coding Assistant

keybind = shift+enter=text:\n
