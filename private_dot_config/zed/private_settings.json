// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "indent_guides": {
    "background_coloring": "indent_aware",
    "coloring": "indent_aware"
  },
  "icon_theme": "Catppuccin Mocha",
  "theme": "Catppuccin Mocha - No Italics",
  "buffer_line_height": "standard",
  "ui_font_size": 16.0,
  "agent": {
    "commit_message_instructions": "Follow the cz-emoji convention: `<type>: <:emoji-code:> <subject>`. Allowed types and emoji codes: feat :sparkles:, fix :bug:, wip :construction:, chore :paperclip:, style :art:, docs :notebook:, perf :zap:, refactor :bulb:, test :100:, release :tada:. Do not include a scope. Keep the subject 72 characters or fewer. Write the emoji as its text code (e.g. :sparkles:).",
    "commit_message_model": {
      "provider": "anthropic",
      "model": "claude-haiku-4-5-20251001",
    },
    "default_model": {
      "provider": "anthropic",
      "model": "claude-opus-4-8",
      "enable_thinking": true,
      "effort": "high",
    },
    "play_sound_when_agent_done": "always",
    "show_turn_stats": true,
  },
  "agent_servers": {
    "claude-acp": {
      "type": "registry",
    },
  },
  "buffer_font_family": "UDEV Gothic 35NF",
  "cli_default_open_behavior": "new_window",
  "experimental.theme_overrides": {
    "background": "#333333cc",
    "background.appearance": "transparent",
    "border": "#99999999",
    "editor.background": "#00000000",
    "editor.gutter.background": "#00000000",
    "tab_bar.background": "#00000000",
    "panel.background": "#00000000",
    "scrollbar.track.background": "#00000000",
    "status_bar.background": "#00000000",
    "toolbar.background": "#00000000",
    "terminal.background": "#00000000",
  },
  "format_on_save": "on",
  "languages": {
    "CSS": {
      "code_actions_on_format": {
        "source.fixAll.biome": true,
      },
      "formatter": {
        "language_server": {
          "name": "biome",
        },
      },
    },
    "JSON": {
      "code_actions_on_format": {
        "source.fixAll.biome": true,
      },
      "formatter": {
        "language_server": {
          "name": "biome",
        },
      },
    },
    "JavaScript": {
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true,
      },
      "formatter": {
        "language_server": {
          "name": "biome",
        },
      },
    },
    "Python": {
      "code_actions_on_format": {
        "source.fixAll.ruff": true,
        "source.organizeImports.ruff": true,
      },
      "formatter": {
        "language_server": {
          "name": "ruff",
        },
      },
    },
    "TSX": {
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true,
      },
      "formatter": {
        "language_server": {
          "name": "biome",
        },
      },
    },
    "TypeScript": {
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true,
      },
      "formatter": {
        "language_server": {
          "name": "biome",
        },
      },
    },
  },
  "load_direnv": "shell_hook",
  "lsp": {
    "biome": {
      "settings": {
        "require_config_file": true,
      },
    },
  },
  "minimap": {
    "show": "auto",
  },
  "session": {
    "trust_all_worktrees": true,
  },
  "soft_wrap": "editor_width",
  "tabs": {
    "file_icons": true,
    "git_status": true,
  },
  "terminal": {
    "toolbar": {
      "breadcrumbs": false,
    },
    "copy_on_select": true,
    "cursor_shape": "block",
    "font_size": 14.0,
    "font_family": "UDEV Gothic 35NF",
  },
  "title_bar": {
    "show_branch_status_icon": true,
  },
  "ui_font_family": "UDEV Gothic 35NF",
}
