# Managed by chezmoi (private_dot_ssh/private_config -> ~/.ssh/config, 0600)
# Read more about SSH config files: https://linux.die.net/man/5/ssh_config
#
# HostName uses stable Tailscale IPs (100.x) instead of MagicDNS names, because the
# OSS tailscaled on macOS does not always register the MagicDNS resolver (it only adds
# the search domain). IPs work from every node regardless of DNS. The MagicDNS FQDN is
# kept in a comment for reference. Run `tailscale ip <host>` to re-check an address.

Host *
  IgnoreUnknown UseKeychain
  AddKeysToAgent yes
  UseKeychain yes
  ServerAliveInterval 60
  ServerAliveCountMax 3

# === Tailscale SSH (keyless) ===
# These hosts authenticate via Tailscale node identity (auth method `none`).
Host macstudio
  HostName 100.82.228.106          # macstudio.taile7dbc.ts.net
  User suzuki

